# Nusxa oling: .env nomi bilan saqlang (faqat kompyuterda test uchun).
# Serverda (Render) bularni "Environment" bo'limiga qo'shasiz.

# BotFather bergan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sizning Telegram ID raqamingiz (@userinfobot dan oling)
ADMIN_ID=123456789

# MongoDB Atlas (bepul) ulanish manzili
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/xitoybot?retryWrites=true&w=majority

# Render'da bu avtomatik (RENDER_EXTERNAL_URL). Boshqa serverda o'zingiz yozing:
# BASE_URL=https://sizning-ilova.onrender.com
